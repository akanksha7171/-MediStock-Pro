PORT=5000
# Neon: paste the connection string from the Neon dashboard (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Use a long random value, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="PASTE_A_LONG_RANDOM_SECRET_HERE"
ADMIN_EMAIL=admin@example.com
# Keep the password in double quotes (a # without quotes cuts it short)
ADMIN_PASSWORD="choose_a_strong_password"
# Optional: extra allowed frontend URLs, comma separated (*.vercel.app is already allowed)
# CORS_ORIGINS=https://your-domain.com
